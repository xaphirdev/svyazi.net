#!/sbin/openrc-run
description="Configure svyazi.net web access"

depend() {
    need docker
    after firewall
}

start() {
    ebegin "Applying svyazi.net firewall rules"
    /usr/local/lib/svyazi.net/firewall.sh --apply
    eend $?
}

# Firewall rules remain in place while the service is restarted.
stop() {
    return 0
}
